---
/**
 * Hot-plug slot: renders active feature UI only.
 */
// @ts-nocheck — pnpm + Astro LS can false-positive TS2306 on .svelte imports; build/check OK.
import features from "../data/features.json";
import heroMedia from "../data/hero-media.json";
import calendar from "../data/calendar.json";
import liveChat from "../data/live-chat.json";
import i18n from "../data/i18n.json";
import HeroMedia from "../features/hero-media/ui/HeroMedia.svelte";
import EventsCalendar from "../features/events-calendar/ui/EventsCalendar.svelte";
import LiveChat from "../features/live-chat/ui/LiveChat.svelte";
import LocaleSwitcher from "../features/i18n/ui/LocaleSwitcher.svelte";
import MailingListSignup from "../features/mailing-list/ui/MailingListSignup.svelte";

const { name } = Astro.props;

function envOn(key = "") {
  const value = import.meta.env[key];
  return Boolean(value && String(value).trim() && value !== "0" && value !== "false");
}

function isActive(id = "") {
  const mod = features.modules.find((m) => m.id === id);
  if (!mod) return false;
  return (mod.publicEnv ?? []).every((key) => envOn(key));
}
---

{
  name === "home.hero-media" && isActive("hero-media") && (
    <HeroMedia client:load slides={heroMedia.slides} intervalMs={heroMedia.intervalMs} />
  )
}
{
  name === "home.events-calendar" && isActive("events-calendar") && (
    <EventsCalendar
      client:visible
      events={calendar.events.filter(
        (event) => String(event.date) >= new Date().toISOString().slice(0, 10),
      )}
    />
  )
}
{
  name === "global.live-chat" && isActive("live-chat") && (
    <LiveChat
      client:idle
      greeting={liveChat.greeting}
      agentName={liveChat.agentName}
      mailtoFallback={liveChat.mailtoFallback}
    />
  )
}
{
  name === "global.locale" && isActive("i18n") && (
    <LocaleSwitcher client:idle locales={i18n.locales} defaultLocale={i18n.defaultLocale} />
  )
}
{name === "footer.mailing-list" && isActive("mailing-list") && <MailingListSignup client:visible />}
