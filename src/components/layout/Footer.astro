---
import site from "../../data/site.json";
import FeatureSlot from "../FeatureSlot.astro";

const {
  title = site.name,
  description = site.description,
  path = "/",
} = Astro.props;

const shareUrl = encodeURIComponent(new URL(path === "/" ? "/" : path, site.url).href);
const shareText = encodeURIComponent(title === site.name ? description : title);

let via = "satellitebarco";
try {
  via = new URL(site.social.twitter).pathname.replace(/\//g, "") || via;
} catch {
  /* keep default */
}

const phoneHref = site.phone.replace(/\D/g, "");
const facebookShare = `https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`;
const xShare = `https://x.com/intent/tweet?url=${shareUrl}&text=${shareText}&via=${via}`;
const instagramShare = site.social.instagram;
---

<footer class="site-footer">
  <div class="site-footer__inner container-site">
    <div class="site-footer__brand-block">
      <p class="site-footer__brand">{site.name}</p>
      <p class="site-footer__area">{site.serviceArea}</p>
      <p class="site-footer__contact">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <span aria-hidden="true">·</span>
        <a href={`tel:${phoneHref}`}>{site.phone}</a>
      </p>
      <FeatureSlot name="footer.mailing-list" />
    </div>

    <div class="site-footer__aside">
      <nav class="site-footer__nav" aria-label="Footer">
        <a href="/book">Book</a>
        <a href="/contact">Contact</a>
        <a href="/about">About</a>
      </nav>
      <nav class="site-footer__share" aria-label="Share this page">
        <p class="site-footer__share-label">Share</p>
        <div class="site-footer__share-links">
          <a href={facebookShare} rel="noopener noreferrer" target="_blank" aria-label="Share on Facebook">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14C17.17 2.09 16.02 2 14.9 2 12.24 2 10.5 3.66 10.5 6.7V9.5H8v4h2.5V22h3.5z"
              />
            </svg>
          </a>
          <a href={xShare} rel="noopener noreferrer" target="_blank" aria-label="Share on X">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.727-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"
              />
            </svg>
          </a>
          {
            instagramShare && (
              <a
                href={instagramShare}
                rel="noopener noreferrer"
                target="_blank"
                aria-label="Open Instagram"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    fill="currentColor"
                    d="M12 7.2A4.8 4.8 0 1 0 12 16.8 4.8 4.8 0 0 0 12 7.2zm0 7.92A3.12 3.12 0 1 1 12 8.88a3.12 3.12 0 0 1 0 6.24zM17.52 6.96a1.12 1.12 0 1 1-2.24 0 1.12 1.12 0 0 1 2.24 0zM12 2.16c-2.68 0-3.02.01-4.07.06-2.73.12-4.01 1.41-4.14 4.14-.05 1.05-.06 1.39-.06 4.07s.01 3.02.06 4.07c.13 2.72 1.4 4.01 4.14 4.14 1.05.05 1.39.06 4.07.06s3.02-.01 4.07-.06c2.73-.13 4.01-1.41 4.14-4.14.05-1.05.06-1.39.06-4.07s-.01-3.02-.06-4.07c-.13-2.73-1.41-4.01-4.14-4.14-1.05-.05-1.39-.06-4.07-.06zm0 1.68c2.64 0 2.95.01 3.99.06 1.98.09 2.91 1.02 3 3 .05 1.04.06 1.35.06 3.99s-.01 2.95-.06 3.99c-.09 1.97-1.02 2.91-3 3-1.04.05-1.35.06-3.99.06s-2.95-.01-3.99-.06c-1.99-.09-2.91-1.03-3-3-.05-1.04-.06-1.35-.06-3.99s.01-2.95.06-3.99c.09-1.98 1.03-2.91 3-3 1.04-.05 1.35-.06 3.99-.06z"
                  />
                </svg>
              </a>
            )
          }
        </div>
      </nav>
    </div>
  </div>
  <p class="site-footer__legal container-site">
    © {new Date().getFullYear()} {site.legalName}
  </p>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--border);
    padding: 1.25rem 0 1rem;
    background: var(--background);
  }

  .site-footer__inner {
    display: grid;
    gap: 1.25rem;
  }

  .site-footer__brand {
    margin: 0 0 0.25rem;
    font-family: var(--font-heading);
    font-size: 1rem;
    letter-spacing: -0.03em;
  }

  .site-footer__area {
    margin: 0 0 0.35rem;
    color: var(--muted-foreground);
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .site-footer__contact {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.5rem;
    margin: 0;
    color: var(--muted-foreground);
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .site-footer__contact a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer__contact a:hover {
    color: var(--foreground);
  }

  .site-footer__aside {
    display: grid;
    gap: 1rem;
  }

  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
  }

  .site-footer__share-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }

  .site-footer__nav a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    min-width: 4.25rem;
    padding: 0.65rem 1rem;
    text-decoration: none;
    color: var(--foreground);
    font-size: 0.92rem;
    font-weight: 600;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: color-mix(in oklch, var(--muted) 35%, transparent);
  }

  .site-footer__nav a:hover {
    border-color: color-mix(in oklch, var(--primary) 45%, var(--border));
    background: color-mix(in oklch, var(--muted) 65%, transparent);
  }

  .site-footer__share {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }

  .site-footer__share-label {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .site-footer__share-links a {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    color: var(--primary);
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: color-mix(in oklch, var(--muted) 40%, transparent);
  }

  .site-footer__share-links a:hover {
    color: var(--foreground);
    border-color: color-mix(in oklch, var(--primary) 55%, var(--border));
    background: color-mix(in oklch, var(--muted) 70%, transparent);
  }

  .site-footer__share-links svg {
    display: block;
    width: 1.35rem;
    height: 1.35rem;
  }

  .site-footer__legal {
    margin: 1rem auto 0;
    color: var(--muted-foreground);
    font-size: 0.72rem;
  }

  @media (min-width: 800px) {
    .site-footer__inner {
      grid-template-columns: 1fr auto;
      align-items: start;
      column-gap: 2rem;
    }

    .site-footer__aside {
      justify-items: end;
      gap: 0.85rem;
    }

    .site-footer__share {
      justify-items: end;
    }

    .site-footer__nav {
      justify-content: flex-end;
      gap: 0.4rem;
    }

    .site-footer__nav a {
      min-height: 2.35rem;
      min-width: 0;
      padding: 0.45rem 0.85rem;
      font-size: 0.85rem;
    }

    .site-footer__share-links {
      justify-content: flex-end;
      gap: 0.45rem;
    }

    .site-footer__share-links a {
      width: 2.5rem;
      height: 2.5rem;
    }

    .site-footer__share-links svg {
      width: 1.15rem;
      height: 1.15rem;
    }
  }
</style>
