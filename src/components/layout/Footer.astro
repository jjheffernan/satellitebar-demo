---
import site from "../../data/site.json";
import FeatureSlot from "../FeatureSlot.astro";

const {
  title = site.name,
  description = site.description,
  path = "/",
} = Astro.props;

const shareUrl = encodeURIComponent(new URL(path === "/" ? "/" : path, site.url).href);
const shareText = encodeURIComponent(title === site.name ? description : title);

let via = "satellitebarco";
try {
  via = new URL(site.social.twitter).pathname.replace(/\//g, "") || via;
} catch {
  /* keep default */
}

const phoneHref = site.phone.replace(/\D/g, "");
const facebookShare = `https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`;
const xShare = `https://x.com/intent/tweet?url=${shareUrl}&text=${shareText}&via=${via}`;
---

<footer class="site-footer">
  <div class="site-footer__inner container-site">
    <div class="site-footer__brand-block">
      <p class="site-footer__brand">{site.name}</p>
      <p class="site-footer__area">{site.serviceArea}</p>
      <p class="site-footer__contact">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <span aria-hidden="true">·</span>
        <a href={`tel:${phoneHref}`}>{site.phone}</a>
      </p>
      <FeatureSlot name="footer.mailing-list" />
    </div>

    <div class="site-footer__aside">
      <nav class="site-footer__nav" aria-label="Footer">
        <a href="/book">Book</a>
        <a href="/contact">Contact</a>
        <a href="/about">About</a>
      </nav>
      <nav class="site-footer__share" aria-label="Share this page">
        <p class="site-footer__share-label">Share</p>
        <div class="site-footer__share-links">
          <a href={facebookShare} rel="noopener noreferrer" target="_blank">Facebook</a>
          <a href={xShare} rel="noopener noreferrer" target="_blank">X</a>
        </div>
      </nav>
    </div>
  </div>
  <p class="site-footer__legal container-site">
    © {new Date().getFullYear()} {site.legalName}
  </p>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--border);
    padding: 1.25rem 0 1rem;
    background: var(--background);
  }

  .site-footer__inner {
    display: grid;
    gap: 1.25rem;
  }

  .site-footer__brand {
    margin: 0 0 0.25rem;
    font-family: var(--font-heading);
    font-size: 1rem;
    letter-spacing: -0.03em;
  }

  .site-footer__area {
    margin: 0 0 0.35rem;
    color: var(--muted-foreground);
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .site-footer__contact {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.5rem;
    margin: 0;
    color: var(--muted-foreground);
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .site-footer__contact a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer__contact a:hover {
    color: var(--foreground);
  }

  .site-footer__aside {
    display: grid;
    gap: 0.85rem;
  }

  .site-footer__nav,
  .site-footer__share-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.1rem;
    margin: 0;
  }

  .site-footer__nav a {
    text-decoration: none;
    color: var(--muted-foreground);
    font-size: 0.82rem;
  }

  .site-footer__nav a:hover {
    color: var(--foreground);
  }

  .site-footer__share {
    display: grid;
    gap: 0.35rem;
    justify-items: start;
  }

  .site-footer__share-label {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .site-footer__share-links a {
    color: var(--primary);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 600;
    border-bottom: 1px solid color-mix(in oklch, var(--primary) 45%, transparent);
  }

  .site-footer__share-links a:hover {
    color: var(--foreground);
    border-bottom-color: var(--foreground);
  }

  .site-footer__legal {
    margin: 1rem auto 0;
    color: var(--muted-foreground);
    font-size: 0.72rem;
  }

  @media (min-width: 800px) {
    .site-footer__inner {
      grid-template-columns: 1fr auto;
      align-items: start;
      column-gap: 2rem;
    }

    .site-footer__aside {
      justify-items: end;
    }

    .site-footer__share {
      justify-items: end;
    }

    .site-footer__nav,
    .site-footer__share-links {
      justify-content: flex-end;
    }
  }
</style>
