---
import site from "../../data/site.json";
import locations from "../../data/locations.json";

const market =
  locations.markets.find((m) => m.id === site.defaultMarket) ?? locations.markets[0];

const {
  brand = site.name,
  eyebrow = market?.eyebrow ?? "Mobile bartending",
  headline = market?.headline ?? site.tagline,
  support = site.description,
  primaryHref = "/book",
  primaryLabel = "Check availability",
  secondaryHref = "/packages",
  secondaryLabel = "View packages",
} = Astro.props;
---

<section class="hero" aria-label="Introduction">
  <div class="hero__plane" aria-hidden="true">
    <div class="hero__orbits"></div>
    <div class="hero__glow"></div>
    <div class="hero__grain"></div>
  </div>
  <div class="hero__content container-site">
    <p class="hero__brand motion-rise">{brand}</p>
    <p class="hero__eyebrow motion-rise-delay">{eyebrow}</p>
    <h1 class="hero__headline motion-rise-delay">{headline}</h1>
    <p class="hero__support motion-rise-delay">{support}</p>
    <div class="hero__actions motion-rise-delay">
      <a class="hero__cta" href={primaryHref}>{primaryLabel}</a>
      <a class="hero__cta hero__cta--ghost" href={secondaryHref}>{secondaryLabel}</a>
    </div>
    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    overflow: clip;
    padding-block: 2rem 1.75rem;
  }

  .hero__plane {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      oklch(0.2 0.04 255deg) 0%,
      oklch(0.14 0.025 250deg) 45%,
      oklch(0.11 0.02 245deg) 100%
    );
  }

  .hero__orbits {
    position: absolute;
    inset: -30% -10% auto;
    height: 85%;
    background:
      radial-gradient(circle at 70% 35%, color-mix(in oklch, var(--primary) 35%, transparent), transparent 28%),
      radial-gradient(circle at 28% 55%, color-mix(in oklch, var(--accent) 28%, transparent), transparent 32%),
      repeating-radial-gradient(
        circle at 68% 38%,
        transparent 0 2.8rem,
        color-mix(in oklch, var(--foreground) 8%, transparent) 2.85rem 2.95rem
      );
    opacity: 0.9;
  }

  .hero__glow {
    position: absolute;
    inset: auto 0 0;
    height: 55%;
    background: linear-gradient(to top, var(--hero-veil), transparent);
  }

  .hero__grain {
    position: absolute;
    inset: -20%;
    opacity: var(--grain-opacity);
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__grain {
      animation: grain-shift 8s steps(2) infinite;
    }
  }

  .hero__content {
    max-width: 42rem;
  }

  .hero__brand {
    margin: 0 0 0.25rem;
    font-family: var(--font-heading);
    font-size: clamp(2.15rem, 9vw, 4.25rem);
    letter-spacing: -0.045em;
    line-height: 0.92;
  }

  .hero__eyebrow {
    margin: 0 0 0.35rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .hero__headline {
    margin: 0 0 0.5rem;
    font-size: clamp(1.05rem, 2.8vw, 1.45rem);
    font-weight: 600;
    color: var(--primary);
  }

  .hero__support {
    margin: 0 0 1rem;
    color: var(--muted-foreground);
    font-size: 0.95rem;
    line-height: 1.4;
    max-width: 32rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.4rem;
    padding: 0.45rem 0.95rem;
    border-radius: var(--radius-md);
    background: var(--primary);
    color: var(--primary-foreground);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .hero__cta--ghost {
    background: transparent;
    color: var(--foreground);
    border: 1px solid var(--border);
  }

  @media (min-width: 800px) {
    .hero {
      min-height: min(52vh, 32rem);
      padding-block: 3.5rem 2.5rem;
    }
  }
</style>
