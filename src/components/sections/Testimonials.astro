---
// @ts-nocheck — pnpm + Astro LS can false-positive TS2306 on .svelte imports; build/check OK.
import testimonials from "../../data/testimonials.json";
import TestimonialsFeed from "../../features/testimonials/ui/TestimonialsFeed.svelte";
import TestimonialForm from "../../features/testimonials/ui/TestimonialForm.svelte";

function envOn(key = "") {
  const value = import.meta.env[key];
  return Boolean(value && String(value).trim() && value !== "0" && value !== "false");
}

const accountsEnabled = envOn("PUBLIC_FEATURE_ACCOUNTS");
---

<section class="quotes" aria-labelledby="quotes-heading">
  <div class="quotes__head">
    <h2 id="quotes-heading">What hosts say</h2>
  </div>
  <TestimonialsFeed client:load seed={testimonials.items} />
  <TestimonialForm client:load enabled={accountsEnabled} />
</section>

<style>
  .quotes {
    margin-top: 0;
  }

  .quotes__head h2 {
    margin: 0 0 0.55rem;
    font-size: 1.05rem;
  }
</style>
