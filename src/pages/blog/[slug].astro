---
import PageLayout from "../../layouts/PageLayout.astro";
import blog from "../../data/blog.json";
import features from "../../data/features.json";

export function getStaticPaths() {
  return blog.posts.map((post) => ({ params: { slug: post.slug } }));
}

function envOn(key = "") {
  const value = import.meta.env[key];
  return Boolean(value && String(value).trim() && value !== "0" && value !== "false");
}

function isActive(id = "") {
  const mod = features.modules.find((m) => m.id === id);
  if (!mod) return false;
  return (mod.publicEnv ?? []).every((key) => envOn(key));
}

const post = blog.posts.find((p) => p.slug === Astro.params.slug);
if (!post || !isActive("blog")) {
  return Astro.redirect("/");
}
---

<PageLayout title={post.title} description={post.excerpt} path={`/blog/${post.slug}`}>
  <p class="date">{post.date}</p>
  <article>
    <p>{post.body}</p>
  </article>
  <p><a href="/blog">All posts</a></p>
</PageLayout>

<style>
  .date {
    color: var(--primary);
    font-size: 0.8rem;
  }

  article p {
    color: var(--muted-foreground);
    max-width: 40rem;
    line-height: 1.5;
  }

  a {
    color: var(--primary);
  }
</style>
