---
import PageLayout from "../../layouts/PageLayout.astro";
import blog from "../../data/blog.json";
import features from "../../data/features.json";

function envOn(key = "") {
  const value = import.meta.env[key];
  return Boolean(value && String(value).trim() && value !== "0" && value !== "false");
}

function isActive(id = "") {
  const mod = features.modules.find((m) => m.id === id);
  if (!mod) return false;
  return (mod.publicEnv ?? []).every((key) => envOn(key));
}

if (!isActive("blog")) {
  return Astro.redirect("/");
}
---

<PageLayout title="Blog" description="Notes on sizing bars, inclusions, and event planning." path="/blog">
  <ul class="posts">
    {
      blog.posts.map((post) => (
        <li>
          <a href={`/blog/${post.slug}`}>
            <span class="date">{post.date}</span>
            <span class="title">{post.title}</span>
            <span class="excerpt">{post.excerpt}</span>
          </a>
        </li>
      ))
    }
  </ul>
</PageLayout>

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  li {
    border-bottom: 1px solid var(--border);
  }

  a {
    display: grid;
    gap: 0.15rem;
    padding: 0.75rem 0;
    text-decoration: none;
  }

  .date {
    color: var(--primary);
    font-size: 0.75rem;
  }

  .title {
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .excerpt {
    color: var(--muted-foreground);
    font-size: 0.88rem;
  }
</style>
