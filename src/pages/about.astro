---
import PageLayout from "../layouts/PageLayout.astro";
import site from "../data/site.json";
---

<PageLayout
  title="About"
  description="Mobile bartending without owning a venue."
  path="/about"
>
  <article class="about">
    <p>
      {site.legalName} brings a staffed bar to your venue. Pick a package and cocktail list; we show
      up with the program, ice, and people.
    </p>
    <p>
      Questions: <a href={`mailto:${site.email}`}>{site.email}</a> · {site.phone}
    </p>
  </article>
</PageLayout>

<style>
  .about p {
    color: var(--muted-foreground);
    font-size: 0.95rem;
    line-height: 1.45;
    max-width: 40rem;
    margin: 0;
  }

  .about p + p {
    margin-top: 0.65rem;
  }
</style>
