---
import PageLayout from "../layouts/PageLayout.astro";
import SocialLinks from "../components/layout/SocialLinks.astro";
import InstagramFeed from "../components/social/InstagramFeed.svelte";
import site from "../data/site.json";

const beholdFeedId = String(import.meta.env.PUBLIC_BEHOLD_FEED_ID ?? "").trim();
const igHandle = site.social.instagram
  ? new URL(site.social.instagram).pathname.replace(/\//g, "")
  : "";
---

<PageLayout
  title="About"
  description="Mobile bartending without owning a venue."
  path="/about"
>
  <article class="about">
    <p>
      {site.legalName} brings a staffed bar to your venue. Pick a package and cocktail list; we show
      up with the program, ice, and people.
    </p>
    <p>
      Questions: <a href={`mailto:${site.email}`}>{site.email}</a> · {site.phone}
    </p>

    <section class="about__social" aria-labelledby="social-heading">
      <h2 id="social-heading">Follow along</h2>
      <p>
        Event setups, menus, and nights on the road.{
          igHandle && (
            <>
              {" "}
              <a href={site.social.instagram} rel="noopener noreferrer" target="_blank">
                @{igHandle}
              </a>
            </>
          )
        }
      </p>
      <SocialLinks />
      {
        beholdFeedId ? (
          <div class="about__feed">
            <InstagramFeed client:only="svelte" feedId={beholdFeedId} />
          </div>
        ) : null
      }
    </section>
  </article>
</PageLayout>

<style>
  .about p {
    color: var(--muted-foreground);
    font-size: 0.95rem;
    line-height: 1.45;
    max-width: 40rem;
    margin: 0;
  }

  .about p + p {
    margin-top: 0.65rem;
  }

  .about a {
    color: var(--primary);
  }

  .about__social {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    max-width: 48rem;
  }

  .about__social h2 {
    margin: 0 0 0.35rem;
    font-size: 1.15rem;
  }

  .about__social > p {
    margin: 0 0 0.85rem;
  }

  .about__feed {
    /* Dimensions live in Astro HTML so SSG doesn't collapse before client:only hydrates */
    margin-top: 1.15rem;
    width: 100%;
    min-height: 24rem;
    background: color-mix(in oklch, var(--muted) 35%, transparent);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: clip;
  }
</style>
