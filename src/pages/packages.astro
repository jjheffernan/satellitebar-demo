---
import PageLayout from "../layouts/PageLayout.astro";
import PackageCatalog from "../components/catalog/PackageCatalog.svelte";
import catalog from "../data/catalog.json";
import eventTypes from "../data/event-types.json";
import sampleMenus from "../data/sample-menus.json";
---

<PageLayout
  title="Packages"
  description="Build a quote with sliders, then browse branded packages and event premades."
  path="/packages"
>
  <PackageCatalog
    client:load
    items={catalog.packages}
    quote={catalog.quote}
    eventTypes={eventTypes.types}
    sampleMenus={sampleMenus.menus}
  />
</PageLayout>
