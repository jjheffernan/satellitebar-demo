---
import BaseLayout from "../../layouts/BaseLayout.astro";
import eventTypes from "../../data/event-types.json";
import eventsMedia from "../../data/events-media.json";
import catalog from "../../data/catalog.json";

export function getStaticPaths() {
  return eventTypes.types.map((type) => ({ params: { type: type.id } }));
}

const type = eventTypes.types.find((t) => t.id === Astro.params.type);
if (!type) {
  return Astro.redirect("/events");
}

const byId = Object.fromEntries(eventsMedia.images.map((img) => [img.id, img]));
const gallery = type.images.map((id) => byId[id]).filter(Boolean);
const cover = gallery[0];
const rest = gallery.slice(1);

const recommended = catalog.packages.filter((p) => type.recommendedPackages.includes(p.id));
---

<BaseLayout title={type.title} description={type.summary} path={`/events/${type.id}`}>
  {
    cover && (
      <section class="landing" aria-label={`${type.title} photography`}>
        <img
          class="landing__img"
          src={cover.src}
          alt={cover.alt}
          width="1600"
          height="900"
          fetchpriority="high"
        />
        <div class="landing__veil" aria-hidden="true"></div>
        <div class="landing__copy container-site">
          <p class="landing__crumb">
            <a href="/events">Events</a>
          </p>
          <h1>{type.title}</h1>
          <p class="landing__summary">{type.summary}</p>
        </div>
      </section>
    )
  }

  {
    rest.length > 0 && (
      <section class="selects" aria-label={`${type.title} gallery`}>
        <div class="selects__grid">
          {rest.map((img) => (
            <figure>
              <img src={img.src} alt={img.alt} width="1200" height="675" loading="lazy" />
              <figcaption>{img.caption}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }

  <section class="recs container-site" aria-labelledby="recs-heading">
    <h2 id="recs-heading">Packages that fit</h2>
    <ul>
      {
        recommended.map((pkg) => (
          <li>
            <h3>{pkg.name}</h3>
            <p>
              {pkg.guests} guests · {pkg.duration} · {pkg.bestFor}
            </p>
            <a href={`/packages#${pkg.id}`}>See package</a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .landing {
    position: relative;
    min-height: min(72vh, 36rem);
    display: grid;
    align-items: end;
    overflow: clip;
    border-bottom: 1px solid var(--border);
  }

  .landing__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .landing__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in oklch, var(--background) 92%, transparent) 0%,
      color-mix(in oklch, var(--background) 35%, transparent) 45%,
      transparent 75%
    );
  }

  .landing__copy {
    position: relative;
    z-index: 1;
    padding-block: 2.5rem 1.75rem;
    max-width: 40rem;
  }

  .landing__crumb {
    margin: 0 0 0.55rem;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .landing__crumb a {
    color: var(--primary);
    text-decoration: none;
    font-weight: 600;
  }

  .landing h1 {
    margin: 0 0 0.4rem;
    font-size: clamp(2rem, 6vw, 3.25rem);
  }

  .landing__summary {
    margin: 0;
    color: var(--muted-foreground);
    font-size: 1rem;
    line-height: 1.45;
  }

  .selects {
    border-bottom: 1px solid var(--border);
  }

  .selects__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.15rem;
  }

  @media (min-width: 640px) {
    .selects__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .selects figure {
    position: relative;
    margin: 0;
    overflow: clip;
    background: var(--muted);
  }

  .selects img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .selects figcaption {
    position: absolute;
    left: 0.55rem;
    bottom: 0.45rem;
    margin: 0;
    padding: 0.15rem 0.4rem;
    font-size: 0.7rem;
    color: var(--foreground);
    background: color-mix(in oklch, var(--background) 72%, transparent);
  }

  .recs {
    padding-block: var(--space-section);
  }

  .recs h2 {
    margin: 0 0 0.85rem;
    font-size: 1.15rem;
  }

  .recs ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  .recs li {
    padding-block: 0.35rem;
    border-bottom: 1px solid var(--border);
  }

  .recs h3 {
    margin: 0 0 0.2rem;
    font-size: 1.05rem;
  }

  .recs p {
    margin: 0 0 0.4rem;
    color: var(--muted-foreground);
    font-size: 0.9rem;
  }

  .recs a {
    color: var(--primary);
    font-weight: 600;
    text-decoration: none;
  }
</style>
