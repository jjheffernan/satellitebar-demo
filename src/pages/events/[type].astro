---
import PageLayout from "../../layouts/PageLayout.astro";
import eventTypes from "../../data/event-types.json";
import catalog from "../../data/catalog.json";

export function getStaticPaths() {
  return eventTypes.types.map((type) => ({ params: { type: type.id } }));
}

const type = eventTypes.types.find((t) => t.id === Astro.params.type);
if (!type) {
  return Astro.redirect("/");
}

const recommended = catalog.packages.filter((p) => type.recommendedPackages.includes(p.id));
---

<PageLayout title={type.title} description={type.summary} path={`/events/${type.id}`}>
  <ul class="recs">
    {
      recommended.map((pkg) => (
        <li>
          <h2>{pkg.name}</h2>
          <p>
            {pkg.guests} guests · {pkg.duration} · {pkg.bestFor}
          </p>
          <a href={`/packages#${pkg.id}`}>See inclusions &amp; pricing</a>
          {" · "}
          <a href={`/book?package=${pkg.id}&eventType=${type.id}`}>Check availability</a>
        </li>
      ))
    }
  </ul>
  <p class="more"><a href="/tools/drink-calculator">Estimate drinks</a> · <a href="/packages">All packages</a></p>
</PageLayout>

<style>
  .recs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }

  li {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 0.85rem;
    background: var(--card);
  }

  h2 {
    margin: 0 0 0.25rem;
    font-size: 1.1rem;
  }

  p {
    margin: 0 0 0.55rem;
    color: var(--muted-foreground);
    font-size: 0.9rem;
  }

  a {
    color: var(--primary);
  }

  .more {
    margin-top: 1rem;
  }
</style>
