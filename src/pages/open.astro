---
import PageLayout from "../layouts/PageLayout.astro";
import BookingForm from "../components/booking/BookingForm.svelte";
import site from "../data/site.json";
import locations from "../data/locations.json";
import features from "../data/features.json";

function envOn(key = "") {
  const value = import.meta.env[key];
  return Boolean(value && String(value).trim() && value !== "0" && value !== "false");
}

function isActive(id = "") {
  const mod = features.modules.find((m) => m.id === id);
  if (!mod) return false;
  return (mod.publicEnv ?? []).every((key) => envOn(key));
}

const bookingModule = isActive("booking");
const formAction = bookingModule ? "/api/booking" : `mailto:${site.email}`;
const formMethod = bookingModule ? "post" : "get";
const hint = bookingModule
  ? "Travel requests go through the same booking Function when PUBLIC_FEATURE_BOOKING is on."
  : "Opens your mail client until the booking module is enabled.";

const sent = Astro.url.searchParams.get("sent") === "1";
---

<PageLayout
  title="Out of our orbit"
  description="Venue outside Newark or Wilmington? Request a travel quote — same booking flow, fewer fields."
  path="/open"
>
  <p class="lead">
    Our usual service radii cover northern Delaware. If your event is farther out, send the basics and
    we’ll confirm travel.
  </p>

  {
    sent && (
      <p class="sent" role="status">
        Got it — we’ll follow up about travel for your venue.
      </p>
    )
  }

  <p class="switch">
    Inside the radius? <a href="/book">Book an event</a>
  </p>

  <BookingForm
    client:load
    variant="outside"
    action={formAction}
    method={formMethod}
    markets={locations.markets}
    region={locations.region}
    hint={hint}
  />
</PageLayout>

<style>
  .lead,
  .switch {
    color: var(--muted-foreground);
    max-width: 40rem;
    font-size: 0.9rem;
    margin: 0 0 0.65rem;
  }

  .switch a,
  .lead a {
    color: var(--primary);
  }

  .sent {
    margin: 0 0 0.85rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--card);
    color: var(--foreground);
    font-size: 0.9rem;
  }
</style>
