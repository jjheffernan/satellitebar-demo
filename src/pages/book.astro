---
// @ts-nocheck — pnpm + Astro LS can false-positive TS2306 on .svelte imports; build/check OK.
import PageLayout from "../layouts/PageLayout.astro";
import BookingForm from "../components/booking/BookingForm.svelte";
import site from "../data/site.json";
import catalog from "../data/catalog.json";
import locations from "../data/locations.json";
import eventTypes from "../data/event-types.json";
import features from "../data/features.json";

const selected = Astro.url.searchParams.get("package") ?? "";
const guestsParam = Astro.url.searchParams.get("guests") ?? "";
const hoursParam = Astro.url.searchParams.get("hours") ?? "";
const marketParam = Astro.url.searchParams.get("market") ?? site.defaultMarket;
const eventTypeParam = Astro.url.searchParams.get("eventType") ?? "";

function envOn(key = "") {
  const value = import.meta.env[key];
  return Boolean(value && String(value).trim() && value !== "0" && value !== "false");
}

function isActive(id = "") {
  const mod = features.modules.find((m) => m.id === id);
  if (!mod) return false;
  return (mod.publicEnv ?? []).every((key) => envOn(key));
}

function packageLabel(pkg) {
  const tier = catalog.quote.menuTiers.find((t) => t.id === pkg.menuId);
  const tierLabel = tier?.label ?? "Bar package";
  return `${tierLabel} · ${pkg.guests} guests`;
}

/** Size bands only — brand/event package names stay off the booking select. */
const bookingPackages = catalog.packages
  .filter((pkg) => pkg.kind === "size")
  .map((pkg) => ({ id: pkg.id, label: packageLabel(pkg) }));

function bookingPackageId(id = "") {
  if (!id) return "";
  if (id === "custom") return "custom";
  const pkg = catalog.packages.find((p) => p.id === id);
  if (!pkg) return "";
  if (pkg.kind === "size") return pkg.id;
  const byMenu = catalog.packages.find((p) => p.kind === "size" && p.menuId === pkg.menuId);
  return byMenu?.id ?? "custom";
}

const selectedBookingPackage = bookingPackageId(selected);
const selectedLabel =
  selectedBookingPackage === "custom"
    ? "Custom"
    : bookingPackages.find((p) => p.id === selectedBookingPackage)?.label;

const bookingModule = isActive("booking");
const formAction = bookingModule ? "/api/booking" : `mailto:${site.email}`;
const formMethod = bookingModule ? "post" : "get";
const hint = bookingModule
  ? "Submits to the booking Function when PUBLIC_FEATURE_BOOKING is on."
  : "Opens your mail client until the booking module is enabled.";
---

<PageLayout
  title="Book an event"
  description="Pick a market, add the venue address, then send date and package details."
  path="/book"
>
  <p class="lead">
    {site.serviceArea} · <a href={`mailto:${site.email}?subject=Event%20booking`}>{site.email}</a>
  </p>

  {
    selectedLabel && (
      <p class="selected">
        Selected package: <strong>{selectedLabel}</strong>
      </p>
    )
  }

  <BookingForm
    client:load
    variant="standard"
    action={formAction}
    method={formMethod}
    packages={bookingPackages}
    markets={locations.markets}
    eventTypes={eventTypes.types}
    region={locations.region}
    selectedPackage={selectedBookingPackage}
    guests={guestsParam}
    hours={hoursParam}
    market={marketParam}
    eventType={eventTypeParam}
    hint={hint}
  />
</PageLayout>

<style>
  .lead,
  .selected {
    color: var(--muted-foreground);
    max-width: 40rem;
    font-size: 0.9rem;
    margin: 0 0 0.65rem;
  }

  .selected {
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--card);
  }

  .lead a {
    color: var(--primary);
  }
</style>
