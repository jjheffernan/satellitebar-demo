---
import PageLayout from "../layouts/PageLayout.astro";
import site from "../data/site.json";

const phoneHref = site.phone.replace(/\D/g, "");

function handleFromUrl(url = "") {
  try {
    return new URL(url).pathname.replace(/\//g, "") || "";
  } catch {
    return "";
  }
}

const badges = [
  {
    key: "instagram",
    label: "Instagram",
    href: site.social.instagram,
    handle: handleFromUrl(site.social.instagram),
  },
  {
    key: "twitter",
    label: "X",
    href: site.social.twitter,
    handle: handleFromUrl(site.social.twitter),
  },
  {
    key: "facebook",
    label: "Facebook",
    href: site.social.facebook,
    handle: handleFromUrl(site.social.facebook),
  },
].filter((b) => b.href);
---

<PageLayout
  title="Contact"
  description="Reach Satellite Bar Co for quotes, menus, and service-area questions."
  path="/contact"
>
  <div class="contact">
    <ul class="contact__details">
      <li>
        <span class="contact__label">Phone</span>
        <a href={`tel:${phoneHref}`}>{site.phone}</a>
      </li>
      <li>
        <span class="contact__label">Email</span>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </li>
      <li>
        <span class="contact__label">Service area</span>
        <span>{site.serviceArea}</span>
      </li>
    </ul>

    <p class="contact__cta">
      <a href="/book">Check availability</a>
    </p>

    {
      badges.length > 0 && (
        <section class="contact__social" aria-labelledby="social-heading">
          <h2 id="social-heading">Profiles</h2>
          <ul class="badges">
            {badges.map((b) => (
              <li>
                <a class="badge" href={b.href} rel="noopener noreferrer" target="_blank">
                  {b.key === "instagram" && (
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                      <path
                        fill="currentColor"
                        d="M12 7.2A4.8 4.8 0 1 0 12 16.8 4.8 4.8 0 0 0 12 7.2zm0 7.92A3.12 3.12 0 1 1 12 8.88a3.12 3.12 0 0 1 0 6.24zM17.52 6.96a1.12 1.12 0 1 1-2.24 0 1.12 1.12 0 0 1 2.24 0zM12 2.16c-2.68 0-3.02.01-4.07.06-2.73.12-4.01 1.41-4.14 4.14-.05 1.05-.06 1.39-.06 4.07s.01 3.02.06 4.07c.13 2.72 1.4 4.01 4.14 4.14 1.05.05 1.39.06 4.07.06s3.02-.01 4.07-.06c2.73-.13 4.01-1.41 4.14-4.14.05-1.05.06-1.39.06-4.07s-.01-3.02-.06-4.07c-.13-2.73-1.41-4.01-4.14-4.14-1.05-.05-1.39-.06-4.07-.06zm0 1.68c2.64 0 2.95.01 3.99.06 1.98.09 2.91 1.02 3 3 .05 1.04.06 1.35.06 3.99s-.01 2.95-.06 3.99c-.09 1.97-1.02 2.91-3 3-1.04.05-1.35.06-3.99.06s-2.95-.01-3.99-.06c-1.99-.09-2.91-1.03-3-3-.05-1.04-.06-1.35-.06-3.99s.01-2.95.06-3.99c.09-1.98 1.03-2.91 3-3 1.04-.05 1.35-.06 3.99-.06z"
                      />
                    </svg>
                  )}
                  {b.key === "twitter" && (
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                      <path
                        fill="currentColor"
                        d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.727-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"
                      />
                    </svg>
                  )}
                  {b.key === "facebook" && (
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                      <path
                        fill="currentColor"
                        d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14C17.17 2.09 16.02 2 14.9 2 12.24 2 10.5 3.66 10.5 6.7V9.5H8v4h2.5V22h3.5z"
                      />
                    </svg>
                  )}
                  <span class="badge__text">
                    <span class="badge__label">{b.label}</span>
                    {b.handle && <span class="badge__handle">@{b.handle}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</PageLayout>

<style>
  .contact {
    max-width: 28rem;
  }

  .contact__details {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  .contact__details li {
    display: grid;
    gap: 0.15rem;
  }

  .contact__label {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .contact__details a,
  .contact__details span:not(.contact__label) {
    color: var(--foreground);
    text-decoration: none;
    font-size: 1rem;
    line-height: 1.4;
  }

  .contact__details a:hover {
    color: var(--primary);
  }

  .contact__cta {
    margin: 1.35rem 0 0;
  }

  .contact__cta a {
    color: var(--primary);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in oklch, var(--primary) 45%, transparent);
  }

  .contact__cta a:hover {
    color: var(--foreground);
    border-bottom-color: var(--foreground);
  }

  .contact__social {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .contact__social h2 {
    margin: 0 0 0.75rem;
    font-size: 1.05rem;
  }

  .badges {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.7rem 0.45rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: color-mix(in oklch, var(--muted) 40%, transparent);
    color: var(--foreground);
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .badge:hover {
    border-color: color-mix(in oklch, var(--primary) 55%, var(--border));
    background: color-mix(in oklch, var(--muted) 70%, transparent);
  }

  .badge svg {
    flex-shrink: 0;
    color: var(--primary);
  }

  .badge__text {
    display: grid;
    gap: 0.05rem;
    line-height: 1.2;
  }

  .badge__label {
    font-size: 0.82rem;
    font-weight: 600;
  }

  .badge__handle {
    font-size: 0.72rem;
    color: var(--muted-foreground);
  }
</style>
