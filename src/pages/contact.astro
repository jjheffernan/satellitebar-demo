---
// @ts-nocheck — pnpm + Astro LS can false-positive TS2306 on .svelte imports; build/check OK.
import PageLayout from "../layouts/PageLayout.astro";
import SocialProfileEmbeds from "../components/social/SocialProfileEmbeds.svelte";
import site from "../data/site.json";
---

<PageLayout
  title="Contact"
  description="Reach Satellite Bar Co for quotes, menus, and service-area questions."
  path="/contact"
>
  <p>
    <a href={`tel:${site.phone.replace(/\D/g, "")}`}>{site.phone}</a><br />
    <a href={`mailto:${site.email}`}>{site.email}</a><br />
    {site.serviceArea}
  </p>
  <p><a class="cta" href="/book">Check availability</a></p>

  <section class="social" aria-labelledby="social-heading">
    <h2 id="social-heading">On social</h2>
    <p class="social__lede">Profiles and recent posts from X, Instagram, and Facebook.</p>
    <SocialProfileEmbeds
      client:only="svelte"
      instagram={site.social.instagram}
      facebook={site.social.facebook}
      twitter={site.social.twitter}
    />
  </section>
</PageLayout>

<style>
  p {
    color: var(--muted-foreground);
    line-height: 1.5;
  }

  .cta {
    color: var(--primary);
    font-weight: 600;
  }

  .social {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .social h2 {
    margin: 0 0 0.25rem;
    font-size: 1.15rem;
  }

  .social__lede {
    margin: 0;
    font-size: 0.9rem;
  }
</style>
