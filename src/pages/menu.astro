---
// @ts-nocheck — pnpm + Astro LS can false-positive TS2306 on .svelte imports; build/check OK.
import PageLayout from "../layouts/PageLayout.astro";
import SampleMenuSelector from "../components/menu/SampleMenuSelector.svelte";
import sampleMenus from "../data/sample-menus.json";
---

<PageLayout
  title="Sample menus"
  description="Pick a menu tier to ballpark the pours — Simple, Mid, or Full custom. Lower tiers clear when you move up."
  path="/menu"
>
  <SampleMenuSelector client:load ballpark={sampleMenus.ballpark} />
</PageLayout>
