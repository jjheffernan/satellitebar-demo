---
// @ts-nocheck — pnpm + Astro LS can false-positive TS2306 on .svelte imports; build/check OK.
import PageLayout from "../layouts/PageLayout.astro";
import SampleMenuSelector from "../components/menu/SampleMenuSelector.svelte";
import sampleMenus from "../data/sample-menus.json";
---

<PageLayout
  title="Sample menus"
  description="Three example bars — simple beer & wine, mid-tier draft and cocktails, or a full custom program."
  path="/menu"
>
  <SampleMenuSelector client:load menus={sampleMenus.menus} />
</PageLayout>
