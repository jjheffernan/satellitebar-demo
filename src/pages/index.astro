---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import FeatureSlot from "../components/FeatureSlot.astro";
import site from "../data/site.json";
import catalog from "../data/catalog.json";

const featured = catalog.packages.filter((p) => p.featured).slice(0, 3);
const sampleDrinks = catalog.cocktails.slice(0, 3);
const money = new Intl.NumberFormat("en-US", {
  style: "currency",
  currency: "USD",
  maximumFractionDigits: 0,
});
---

<BaseLayout title={site.name} description={site.description} path="/">
  <Hero support="Packages + cocktail menu for weddings, corporate, and private events.">
    <FeatureSlot name="home.hero-media" />
  </Hero>

  <section class="hub container-site" aria-labelledby="order-heading">
    <div class="hub__head">
      <h2 id="order-heading">Packages</h2>
      <a href="/packages">All packages</a>
    </div>
    <ul class="hub__packages">
      {
        featured.map((pkg) => (
          <li>
            <a href={`/book?package=${pkg.id}`}>
              <span class="name">{pkg.name}</span>
              <span class="meta">
                {pkg.guests} · from {money.format(pkg.fromPrice)}
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="hub__head hub__head--next">
      <h2 id="drinks-heading">Cocktails</h2>
      <a href="/menu">Full menu</a>
    </div>
    <ul class="hub__drinks" aria-labelledby="drinks-heading">
      {
        sampleDrinks.map((drink) => (
          <li>
            <span class="name">{drink.name}</span>
            <span class="meta">{drink.description}</span>
          </li>
        ))
      }
    </ul>

    <div class="hub__head hub__head--next">
      <h2 id="cal-heading">Upcoming</h2>
    </div>
    <FeatureSlot name="home.events-calendar" />
  </section>
</BaseLayout>

<style>
  .hub {
    padding-block: 1.25rem var(--space-section);
  }

  .hub__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.55rem;
  }

  .hub__head--next {
    margin-top: 1.35rem;
  }

  .hub__head h2 {
    margin: 0;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }

  .hub__head a {
    color: var(--primary);
    font-size: 0.85rem;
    text-decoration: none;
  }

  .hub__packages,
  .hub__drinks {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .hub__packages li,
  .hub__drinks li {
    border-bottom: 1px solid var(--border);
  }

  .hub__packages a {
    display: grid;
    gap: 0.1rem;
    padding: 0.7rem 0;
    text-decoration: none;
  }

  .hub__drinks li {
    display: grid;
    gap: 0.1rem;
    padding: 0.65rem 0;
  }

  .name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.98rem;
  }

  .meta {
    color: var(--muted-foreground);
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .hub__packages a:hover .name {
    color: var(--primary);
  }
</style>
