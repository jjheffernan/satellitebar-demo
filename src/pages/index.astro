---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import FeatureSlot from "../components/FeatureSlot.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import site from "../data/site.json";

const hubLinks = [
  {
    href: "/packages",
    label: "Packages",
    image: "/media/hero-orbit.svg",
  },
  {
    href: "/tools/drink-calculator",
    label: "Drink calculator",
    image: "/media/hero-signal.svg",
  },
  {
    href: "/menu",
    label: "Sample menu",
    image: "/media/hero-deep.svg",
  },
];
---

<BaseLayout title={site.name} description={site.description} path="/">
  <Hero support="Mobile bartending for weddings, corporate, and private events.">
    <FeatureSlot name="home.hero-media" />
  </Hero>

  <section class="hub container-site">
    <Testimonials />

    <div class="hub__block">
      <div class="hub__block-head">
        <h2 id="cal-heading">Upcoming</h2>
        <a class="hub__block-link" href="/calendar">Full calendar</a>
      </div>
      <FeatureSlot name="home.events-calendar" />
    </div>

    <nav class="hub__links" aria-label="Explore">
      {
        hubLinks.map((link) => (
          <a class="hub__card" href={link.href}>
            <img src={link.image} alt="" width="640" height="400" loading="lazy" />
            <span>{link.label}</span>
          </a>
        ))
      }
    </nav>
  </section>
</BaseLayout>

<style>
  .hub {
    padding-block: 1.25rem var(--space-section);
  }

  .hub__block {
    margin-top: 1.35rem;
  }

  .hub__block-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0 0 0.55rem;
  }

  .hub__block h2 {
    margin: 0;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }

  .hub__block-link {
    color: var(--primary);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .hub__block-link:hover {
    text-decoration: underline;
  }

  .hub__links {
    margin-top: 1.5rem;
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 720px) {
    .hub__links {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.85rem;
    }
  }

  .hub__card {
    position: relative;
    display: grid;
    place-items: end start;
    min-height: 9.5rem;
    overflow: clip;
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--card);
  }

  .hub__card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.72;
  }

  .hub__card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in oklch, var(--background) 88%, transparent) 0%,
      color-mix(in oklch, var(--background) 20%, transparent) 55%,
      transparent 100%
    );
  }

  .hub__card span {
    position: relative;
    z-index: 1;
    padding: 0.85rem 0.95rem;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--foreground);
  }

  .hub__card:hover span {
    color: var(--primary);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hub__card img {
      transition: transform 280ms ease, opacity 280ms ease;
    }

    .hub__card:hover img {
      transform: scale(1.04);
      opacity: 0.88;
    }
  }
</style>
