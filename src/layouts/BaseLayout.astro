---
import Header from "../components/layout/Header.svelte";
import Footer from "../components/layout/Footer.astro";
import SEO from "../components/seo/SEO.astro";
import FeatureSlot from "../components/FeatureSlot.astro";
import site from "../data/site.json";
import features from "../data/features.json";
import "../styles/global.css";

const {
  title,
  description = site.description,
  path = Astro.url.pathname,
  showHeader = true,
  showFooter = true,
} = Astro.props;

function envOn(key = "") {
  const value = import.meta.env[key];
  return Boolean(value && String(value).trim() && value !== "0" && value !== "false");
}

const activeFeatures = features.modules
  .filter((mod) => (mod.publicEnv ?? []).every((key) => envOn(key)))
  .map((mod) => mod.id);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <SEO title={title} description={description} path={path} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {
      showHeader && (
        <Header
          client:load
          pathname={Astro.url.pathname}
          links={site.nav}
          phone={site.phone}
          activeFeatures={activeFeatures}
        />
      )
    }
    <main id="main">
      <slot />
    </main>
    {showFooter && <Footer />}
    <FeatureSlot name="global.live-chat" />
    <FeatureSlot name="global.locale" />
  </body>
</html>

<style is:global>
  body {
    display: flex;
    min-height: 100vh;
    flex-direction: column;
    background: var(--background);
    color: var(--foreground);
  }

  main {
    flex: 1;
  }

  .skip-link {
    position: absolute;
    left: 1rem;
    top: -3rem;
    z-index: 100;
    background: var(--primary);
    color: var(--primary-foreground);
    padding: 0.5rem 0.85rem;
    border-radius: var(--radius-md);
  }

  .skip-link:focus {
    top: 1rem;
  }
</style>
