# Environment example — copy to `.env` for local ops flags

# Content (events, locations, calculator, hero media, social, calendar) is always on.

# Instagram feed (Pane) — optional; omit for profile-link fallback
# PUBLIC_PANE_FEED_ID=

# PUBLIC_FEATURE_LIVE_CHAT=1
# Leave i18n off until translated copy exists
# PUBLIC_FEATURE_I18N=0
# PUBLIC_FEATURE_MAILING_LIST=0
# Accounts — Better Auth + Google; leave off until secrets + DB are ready
# PUBLIC_FEATURE_ACCOUNTS=0
# PUBLIC_FEATURE_BOOKING=1
# PUBLIC_FEATURE_PAYMENTS=0

# Secrets (Pages / .dev.vars — never commit)
# MAILING_LIST_API_KEY=
# STRIPE_SECRET_KEY=

# Better Auth + Google SSO (accounts)
# BETTER_AUTH_SECRET=          # long random string (≥32 chars); AUTH_SECRET accepted as alias
# BETTER_AUTH_URL=https://your-domain.example
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_DATABASE_URL=libsql://your-db.turso.io
# AUTH_DATABASE_AUTH_TOKEN=    # Turso / remote libSQL token

# Admin allowlist (comma-separated Google emails) — testimonials + calendar admin
# ADMIN_EMAILS=you@gmail.com
# Calendar events also use AUTH_DATABASE_* (same libSQL as auth)
