# Environment example — copy to `.env` for local ops flags

# Content (events, locations, calculator, hero media, social, calendar) is always on.

# PUBLIC_FEATURE_LIVE_CHAT=1
# PUBLIC_FEATURE_I18N=1
# PUBLIC_FEATURE_MAILING_LIST=0
# PUBLIC_FEATURE_ACCOUNTS=0
# PUBLIC_FEATURE_BOOKING=1
# PUBLIC_FEATURE_PAYMENTS=0

# Behold Instagram feed on /about (create feed at https://app.behold.so for @satellitebarco)
# PUBLIC_BEHOLD_FEED_ID=

# Secrets (Pages / .dev.vars — never commit)
# MAILING_LIST_API_KEY=
# AUTH_SECRET=
# STRIPE_SECRET_KEY=
