{
  "name": "satellitebar-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Satellite Bar Co — mobile bartending hub (Astro + Svelte)",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && wrangler pages functions build --outdir=./.cf-worker --compatibility-date=2026-06-24 --compatibility-flag=nodejs_compat",
    "preview": "astro preview",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "astro": "astro",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^9.0.1",
    "@fontsource-variable/dm-sans": "^5.2.5",
    "@fontsource-variable/syne": "^5.2.5",
    "@libsql/client": "^0.17.4",
    "@libsql/kysely-libsql": "^0.4.1",
    "@svar-ui/svelte-calendar": "^2.6.0",
    "@tailwindcss/vite": "^4.1.11",
    "astro": "^7.1.3",
    "better-auth": "^1.6.26",
    "kysely": "^0.29.4",
    "maplibre-gl": "^6.1.0",
    "svelte": "^5.36.0",
    "svelte-maplibre": "^2.0.0",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/language-server": "2.16.13",
    "svelte-check": "^4.7.4",
    "svelte2tsx": "^0.7.59",
    "typescript": "~5.9.2",
    "wrangler": "^4.120.1"
  }
}
